[Unit]
Description=GitHub webhook -> deploy listener
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/webhook-deploy
ExecStart=/home/deploy/webhook-deploy/webhook-deploy-bin
Restart=on-failure
RestartSec=5

# All config lives in .env (see .env.example)
# systemd parses KEY=VALUE only.
EnvironmentFile=/home/deploy/webhook-deploy/.env

[Install]
WantedBy=multi-user.target
